@using WarehouseSimulator.Core.Application.Services.Machines
@using WarehouseSimulator.Core.Domain.Machines
@using WarehouseSimulator.Core.SignalR
@using WarehouseSimulator.Core.SignalR.Messages
@using WarehouseSimulator.Web.Components.Machines
@using WarehouseSimulator.Web.Components.StorageLocations

@page "/"
@inject IMachineService MachineService
@inject WarehouseHubClient HubClient
@rendermode InteractiveServer

<div class="dashboard">
    <div class="dashboard-top">
        <div class="machines-section">
            <h2>Maskiner</h2>
            <div class="machine-cards">
                @foreach (var machine in machines)
                {
                    <MachineCard Machine="@machine" />
                }
            </div>
        </div>
        <div class="storage-section">
            <h2>Pallställ</h2>
            <StorageRack />
        </div>
    </div>
</div>

@code {
    private List<MachineView> machines = new();

    protected override async Task OnInitializedAsync()
    {
        machines = await MachineService.GetMachinesAsync();

        await HubClient.StartAsync();

        HubClient.On<MachineStatusUpdate>("MachineStatusUpdated", async (update) =>
        {
            var machine = machines.FirstOrDefault(m => m.Id == update.MachineId);
            if (machine is not null)
            {
                machine.Status = Enum.Parse<MachineStatus>(update.Status);
                if (update.TotalBreakdowns.HasValue)
                    machine.TotalBreakdowns = update.TotalBreakdowns.Value;
            }
            await InvokeAsync(StateHasChanged);
        });
    }
}