@using WarehouseSimulator.Core.Application.Services.Machines
@using WarehouseSimulator.Core.Domain.Machines
@inject IMachineService MachineService

<div class="machine-card @GetStatusClass()">
    <div class="machine-header">
        <span class="machine-icon">⚙️</span>
        <h3>@GetMachineName()</h3>
    </div>

    <div class="machine-status">
        <span class="status-indicator"></span>
        <span>@Machine.Status</span>
    </div>

    <div class="machine-stats">
        <span>Haverier: @Machine.TotalBreakdowns</span>
    </div>

    @if (Machine.Status == MachineStatus.Broken)
    {
        <button class="repair-btn" @onclick="OnRepairClicked">
            🔧 Laga maskin
        </button>
    }
</div>

@code {
    [Parameter]
    public MachineView Machine { get; set; } = null!;

    private async Task OnRepairClicked()
    {
        await MachineService.RepairMachineAsync(Machine.Id);
    }

    private string GetStatusClass() => Machine.Status switch
    {
        MachineStatus.Running => "status-running",
        MachineStatus.Broken => "status-broken",
        MachineStatus.Repairing => "status-repairing",
        _ => ""
    };

    private string GetMachineName() => Machine.Type switch
    {
        MachineType.Production => "Production Machine",
        MachineType.Storage => "Storage Machine",
        _ => "Unknown machine"
    };
}